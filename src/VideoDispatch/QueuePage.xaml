<UserControl x:Class="VideoDispatch.App.QueuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,26,36,16">
      <TextBlock Text="Queue" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,20"
                 Text="Uploads run while this app is open. If you close it, they carry on the next time you open it." />

      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource VisibleIf}}">
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
      </Border>

      <TextBlock Style="{StaticResource Muted}" Text="Nothing here yet. Videos you queue under New post show up here."
                 Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIf}}" />

      <!-- Not focusable, for the same reason as the Accounts page. -->
      <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.Name="{Binding Title}">
              <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                  <Run Text="{Binding PlatformText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding FileText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                <ProgressBar Margin="0,10,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding ProgressIsUnknown}"
                             Visibility="{Binding ShowsProgress, Converter={StaticResource VisibleIf}}" />

                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasDetail, Converter={StaticResource VisibleIf}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowsCaption, Converter={StaticResource VisibleIf}}">
                  <TextBlock Text="Caption to paste in TikTok" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copy" Click="CopyCaption_Click" Margin="8,0,0,0" VerticalAlignment="Top" />
                    <TextBox Text="{Binding Caption, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                  </DockPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding HasStudioLink, Converter={StaticResource VisibleIf}}">
                  <Hyperlink NavigateUri="{Binding StudioLink}" RequestNavigate="Link_RequestNavigate">Open in YouTube Studio</Hyperlink>
                </TextBlock>

                <!-- Under the text, because a job can have three buttons, which leave too little room beside it. -->
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="I've posted it" Click="MarkPosted_Click" Margin="0,0,8,0"
                          Visibility="{Binding CanMarkPosted, Converter={StaticResource VisibleIf}}" />
                  <Button Content="{Binding RetryText}" Click="Retry_Click" Margin="0,0,8,0"
                          Visibility="{Binding CanRetry, Converter={StaticResource VisibleIf}}" />
                  <Button Content="{Binding CancelText}" ToolTip="{Binding CancelHint}" Click="Cancel_Click"
                          Visibility="{Binding CanCancel, Converter={StaticResource VisibleIf}}" />
                  <Button Content="Remove" Click="Remove_Click"
                          Visibility="{Binding CanRemove, Converter={StaticResource VisibleIf}}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
