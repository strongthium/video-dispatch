<Project Sdk="Microsoft.NET.Sdk">
  <!-- video-dispatch: publishes video to TikTok and YouTube. In WPF with Windows' own Fluent theme, so the program itself
       is small: everything it draws with is in the .NET Desktop Runtime. Published as one file for x64 PCs that runs on
       the .NET 10 Desktop Runtime installed on the PC: build.ps1 and .github/workflows/release.yml make it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <AssemblyName>video-dispatch</AssemblyName>
    <RootNamespace>VideoDispatch.App</RootNamespace>
    <!-- Windows' media tools need this target. See PackWinRT below for what it costs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ApplicationIcon>Assets\video-dispatch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main starts the App: it reads the command line first. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- WPF0001: the Fluent theme is experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- The runtime isn't inside it: the .NET 10 Desktop Runtime on the PC runs it. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- A release is the one program: no debug symbols beside it, and Microsoft's 23 MB library for reaching Windows'
       media tools goes in zipped, at about 6 MB, because a single file that needs the runtime can't be compressed as a
       whole. WinRtLibrary unpacks it the first time something is encoded. -->
  <Target Name="LeaveOut" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' Or '%(Filename)' == 'Microsoft.Windows.SDK.NET'" />
    </ItemGroup>
  </Target>

  <Target Name="PackWinRT" BeforeTargets="PrepareForBuild;CoreCompile;PrepareResources" DependsOnTargets="ResolveFrameworkReferences;ResolveRuntimePackAssets" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <WinRTToPack Include="@(RuntimePackAsset)" Condition="'%(Filename)' == 'Microsoft.Windows.SDK.NET'" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)winrt" />
    <Copy SourceFiles="@(WinRTToPack)" DestinationFolder="$(IntermediateOutputPath)winrt" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)winrt" DestinationFile="$(IntermediateOutputPath)winrt.zip" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)winrt.zip" LogicalName="winrt.zip" />
    </ItemGroup>
  </Target>

  <!-- WPF leaves System.IO out of the implicit usings (it has a Path of its own, in Shapes). -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\video-dispatch.png" />
    <Resource Include="Assets\strongthium-banner.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoDispatch.Core\VideoDispatch.Core.csproj" />
    <ProjectReference Include="..\VideoDispatch.Editing\VideoDispatch.Editing.csproj" />
  </ItemGroup>
</Project>
