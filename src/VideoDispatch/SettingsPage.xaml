<UserControl x:Class="VideoDispatch.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,26,36,16">
      <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,20"
                 Text="How videos are re-encoded, when you ask for that under New post." />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Re-encoding" Style="{StaticResource Heading}" />
          <TextBlock Text="{Binding EngineText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />

          <TextBlock Text="FFmpeg (optional)" FontWeight="SemiBold" Margin="0,18,0,4" />
          <TextBlock Style="{StaticResource Muted}">
            Nothing here needs FFmpeg. It reads more formats than Windows does, and aims at a quality rather than a bitrate.
            It isn't part of this app. FFmpeg's own site offers only source code, and points Windows users to outside builders,
            so the button below fetches the stable build from one of them: gyan.dev. That's about 115 MB, under the GPLv3 licence.
            <Hyperlink NavigateUri="https://ffmpeg.org/download.html" RequestNavigate="Link_RequestNavigate">FFmpeg's download page</Hyperlink>
          </TextBlock>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Download FFmpeg" Click="Download_Click" IsEnabled="{Binding CanDownload}" Margin="0,0,8,0" />
            <Button Content="Cancel" Click="CancelDownload_Click" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleIf}}" />
          </StackPanel>

          <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="{Binding DownloadText}" Margin="0,0,0,6" />
            <ProgressBar Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}" IsIndeterminate="{Binding DownloadProgressIsUnknown}" />
          </StackPanel>

          <StackPanel Margin="0,12,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <Button Content="Update FFmpeg" Click="Download_Click" IsEnabled="{Binding CanUpdate}" HorizontalAlignment="Left" />
          </StackPanel>

          <TextBlock Text="Or use a copy you already have" Style="{StaticResource Caption}" Margin="0,16,0,4" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Choose…" Click="Choose_Click" Margin="8,0,0,0" />
            <TextBox Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Path to ffmpeg.exe" />
          </DockPanel>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Use this copy" Click="Use_Click" IsEnabled="{Binding CanUse}" Margin="0,0,8,0" />
            <Button Content="Use Windows' tools" Click="StopUsing_Click" IsEnabled="{Binding CanStopUsing}" />
          </StackPanel>

          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasMessage, Converter={StaticResource VisibleIf}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0"
                     Text="While a downloaded copy is in use, this app asks gyan.dev for the newest version number about once a day, and offers an update here. It never installs one until you press Update. Going back to Windows' tools removes the downloaded copy." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
