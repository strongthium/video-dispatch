<UserControl x:Class="VideoDispatch.App.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,26,36,16">
      <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,20"
                 Text="How videos are re-encoded, when you ask for that under New post." />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Re-encoding" Style="{StaticResource Heading}" />
          <TextBlock Text="{Binding EngineText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />

          <TextBlock Text="FFmpeg (optional)" FontWeight="SemiBold" Margin="0,18,0,4" />
          <TextBlock Style="{StaticResource Muted}">
            Nothing here needs FFmpeg. If you already have it or want it, it reads more formats than Windows does, and aims
            at a quality rather than a bitrate. This app doesn't include it or download it, so point to your own copy.
            <Hyperlink NavigateUri="https://ffmpeg.org/download.html" RequestNavigate="Link_RequestNavigate">Get FFmpeg</Hyperlink>
          </TextBlock>

          <TextBlock Text="ffmpeg.exe" Style="{StaticResource Caption}" Margin="0,12,0,4" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Choose…" Click="Choose_Click" Margin="8,0,0,0" />
            <TextBox Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Path to ffmpeg.exe" />
          </DockPanel>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Use FFmpeg" Click="Use_Click" IsEnabled="{Binding CanUse}" Margin="0,0,8,0" />
            <Button Content="Use Windows' tools" Click="StopUsing_Click" IsEnabled="{Binding CanStopUsing}" />
          </StackPanel>

          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasMessage, Converter={StaticResource VisibleIf}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
