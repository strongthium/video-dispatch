<Window x:Class="VideoDispatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VideoDispatch.App"
        Title="Video Dispatch"
        Width="1080" Height="820" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <!-- Laid out like Windows' own Settings: the places down the side, the chosen one beside them on a layer of its own. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Margin="10,6,10,14">
      <TextBlock Text="Video Dispatch" FontSize="15" FontWeight="SemiBold" Margin="14,10,0,22" />
      <RadioButton Style="{StaticResource PlaceItem}" GroupName="Places" IsChecked="True">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="18" />
          <TextBlock Text="Accounts" Margin="13,0,0,0" />
        </StackPanel>
      </RadioButton>
    </StackPanel>

    <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,26,36,8">
          <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
          <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,20"
                     Text="Video Dispatch has no server. You register your own TikTok and Google apps, and your keys and sign-ins stay in Windows Credential Manager." />
          <!-- Not focusable: a button disabled while it's working would hand it the focus, and draw a frame round every card. -->
          <ItemsControl x:Name="Panels" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:AccountPanel}">
                <local:AccountCard />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
