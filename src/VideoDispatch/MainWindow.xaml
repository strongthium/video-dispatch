<Window x:Class="VideoDispatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Dispatch"
        Width="1080" Height="820" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <!-- Laid out like Windows' own Settings: the places down the side, the chosen one beside them on a layer of its own. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Margin="10,6,10,14">
      <TextBlock DockPanel.Dock="Top" Text="Video Dispatch" FontSize="15" FontWeight="SemiBold" Margin="14,10,0,22" />
      <RadioButton x:Name="AboutPlace" DockPanel.Dock="Bottom" Style="{StaticResource PlaceItem}" GroupName="Places" Tag="about" Checked="Place_Checked" AutomationProperties.Name="About">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="18" />
          <TextBlock Text="About" Margin="13,0,0,0" />
        </StackPanel>
      </RadioButton>
      <StackPanel>
        <RadioButton x:Name="NewPlace" Style="{StaticResource PlaceItem}" GroupName="Places" Tag="new" Checked="Place_Checked" AutomationProperties.Name="New post">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="18" />
            <TextBlock Text="New post" Margin="13,0,0,0" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="EditPlace" Style="{StaticResource PlaceItem}" GroupName="Places" Tag="edit" Checked="Place_Checked" AutomationProperties.Name="Edit">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="18" />
            <TextBlock Text="Edit" Margin="13,0,0,0" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="QueuePlace" Style="{StaticResource PlaceItem}" GroupName="Places" Tag="queue" Checked="Place_Checked" AutomationProperties.Name="Queue">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="18" />
            <TextBlock Text="Queue" Margin="13,0,0,0" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="PresetsPlace" Style="{StaticResource PlaceItem}" GroupName="Places" Tag="presets" Checked="Place_Checked" AutomationProperties.Name="Presets">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="18" />
            <TextBlock Text="Presets" Margin="13,0,0,0" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="AccountsPlace" Style="{StaticResource PlaceItem}" GroupName="Places" Tag="accounts" Checked="Place_Checked" AutomationProperties.Name="Accounts">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="18" />
            <TextBlock Text="Accounts" Margin="13,0,0,0" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="SettingsPlace" Style="{StaticResource PlaceItem}" GroupName="Places" Tag="settings" Checked="Place_Checked" AutomationProperties.Name="Settings">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="18" />
            <TextBlock Text="Settings" Margin="13,0,0,0" />
            <!-- An update for a downloaded FFmpeg is waiting. -->
            <Ellipse x:Name="SettingsBadge" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                     Fill="{DynamicResource AccentFillColorDefaultBrush}" ToolTip="An update for FFmpeg is available" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </DockPanel>

    <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <ContentControl x:Name="Page" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Border>
  </Grid>
</Window>
