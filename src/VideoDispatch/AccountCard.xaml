<UserControl x:Class="VideoDispatch.App.AccountCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One platform: whether it's connected and the buttons for that, then the keys of the user's own app. -->
  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
    <StackPanel>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
          <Button Content="Cancel sign-in" Click="CancelSignIn_Click" Margin="0,0,8,0"
                  Visibility="{Binding IsWaitingForSignIn, Converter={StaticResource VisibleIf}}" />
          <Button Content="Disconnect" Click="Disconnect_Click" Margin="0,0,8,0" IsEnabled="{Binding CanDisconnect}" />
          <Button Content="{Binding ConnectText}" Click="Connect_Click" Style="{DynamicResource AccentButtonStyle}" IsEnabled="{Binding CanConnect}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
          <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>

      <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding IsWaitingForSignIn, Converter={StaticResource VisibleIf}}" />
      <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Finish signing in, in your browser."
                 Visibility="{Binding IsWaitingForSignIn, Converter={StaticResource VisibleIf}}" />

      <StackPanel Margin="0,12,0,0" Visibility="{Binding HasMessage, Converter={StaticResource VisibleIf}}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Margin="0,4,0,0" Visibility="{Binding ShowsRevokeLink, Converter={StaticResource VisibleIf}}">
          <Hyperlink NavigateUri="{Binding RevokeLink}" RequestNavigate="Link_RequestNavigate"><Run Text="{Binding RevokeLinkText, Mode=OneWay}" /></Hyperlink>
        </TextBlock>
      </StackPanel>

      <Separator Margin="0,16" />

      <TextBlock Text="Your app's keys" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SetupText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
      <TextBox Text="{Binding RedirectUri, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0" MaxWidth="320" HorizontalAlignment="Left"
               Visibility="{Binding HasRedirectUri, Converter={StaticResource VisibleIf}}" />
      <TextBlock Margin="0,6,0,0" FontSize="12">
        <Hyperlink NavigateUri="{Binding RegisterLink}" RequestNavigate="Link_RequestNavigate"><Run Text="{Binding RegisterLinkText, Mode=OneWay}" /></Hyperlink>
      </TextBlock>

      <Grid Margin="0,12,0,0" IsEnabled="{Binding CanEditKeys}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding ClientIdLabel}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
          <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="{Binding ClientSecretLabel}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
          <PasswordBox x:Name="Secret" PasswordChanged="Secret_PasswordChanged" />
          <TextBlock Text="A secret is saved. Leave this empty to keep it." Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Visibility="{Binding HasSavedSecret, Converter={StaticResource VisibleIf}}" />
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="Save keys" Click="SaveKeys_Click" IsEnabled="{Binding CanEditKeys}" />
        <Button Content="Remove keys" Click="RemoveKeys_Click" Margin="8,0,0,0" IsEnabled="{Binding CanRemoveKeys}" />
      </StackPanel>
      <TextBlock Text="Disconnect to change the keys." Style="{StaticResource Caption}" Margin="0,6,0,0"
                 Visibility="{Binding IsConnected, Converter={StaticResource VisibleIf}}" />

      <StackPanel Margin="0,16,0,0" Visibility="{Binding OffersPlaylists, Converter={StaticResource VisibleIf}}">
        <CheckBox Content="Add videos to playlists" IsChecked="{Binding WantsPlaylists}" IsEnabled="{Binding CanChoosePlaylists}" />
        <TextBlock Text="{Binding PlaylistNote}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
