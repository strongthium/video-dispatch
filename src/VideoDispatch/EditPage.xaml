<UserControl x:Class="VideoDispatch.App.EditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Focusable="True" FocusVisualStyle="{x:Null}">
  <!-- The preview and the chosen thing's settings on top, the clips, sounds and words along a timeline under them, and
       saving at the bottom. Files can be dropped anywhere on the page. The timeline is drawn in code, in EditPage.xaml.cs. -->
  <Grid Margin="36,26,36,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="200" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Edit" Style="{StaticResource PageTitle}" />
    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,16"
               Text="Cut, trim and put videos in order, add music and words, then save them as one new video. Your files aren't changed." />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="290" />
      </Grid.ColumnDefinitions>

      <!-- The preview, in the shape the video is saved at. Paused, the picture is a still, which is exact; playing, it's
           Windows' player. Zoom, fades, crossfades and words are drawn over them as saving draws them. -->
      <Border Background="Black" CornerRadius="8" ClipToBounds="True">
        <Grid>
          <Viewbox Stretch="Uniform">
            <Grid x:Name="Screen" Width="1920" Height="1080" ClipToBounds="True" Background="Black">
              <Grid x:Name="Pictures">
                <Grid x:Name="StillHost">
                  <Image x:Name="Still" Stretch="Uniform" />
                </Grid>
                <Grid x:Name="PlayerHost">
                  <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False" Stretch="Uniform" Visibility="Hidden" IsMuted="False" />
                  <MediaElement x:Name="Standby" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="False" Stretch="Uniform" Visibility="Hidden" IsMuted="False" />
                </Grid>
                <Grid x:Name="OverHost">
                  <Image x:Name="OverStill" Stretch="Uniform" Opacity="0" />
                </Grid>
              </Grid>
              <Image x:Name="Cover" Stretch="Fill" Visibility="Hidden" />
              <Rectangle x:Name="Darken" Fill="Black" Opacity="0" IsHitTestVisible="False" />
              <Grid x:Name="Words" IsHitTestVisible="False" />
            </Grid>
          </Viewbox>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="40" Foreground="#99FFFFFF" HorizontalAlignment="Center" />
            <TextBlock Text="Drop videos here, or choose Add videos." Foreground="#CCFFFFFF" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- The chosen clip's, sound's or words' settings. -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="16,14,16,14">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel IsEnabled="{Binding CanEdit}" Margin="0,0,14,0">
            <TextBlock Text="{Binding ChosenName}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Choose a clip, sound or words on the timeline to change it." Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Visibility="{Binding IsNothingChosen, Converter={StaticResource VisibleIf}}" />

            <!-- A clip -->
            <StackPanel Visibility="{Binding HasClipChosen, Converter={StaticResource VisibleIf}}">
              <DockPanel Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClipVolumeText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Its sound" />
              </DockPanel>
              <Slider Minimum="0" Maximum="400" SmallChange="5" LargeChange="25" Value="{Binding ClipVolume}" AutomationProperties.Name="Clip volume" />
              <ComboBox Margin="0,6,0,0" SelectedIndex="{Binding ClipLevelIndex}" AutomationProperties.Name="Even out its sound">
                <ComboBoxItem Content="As recorded" />
                <ComboBoxItem Content="As loud as it can be" />
                <ComboBoxItem Content="Evened out, as for speech" />
              </ComboBox>
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClipSpeedText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Speed" />
              </DockPanel>
              <Slider x:Name="SpeedSlider" Minimum="25" Maximum="400" SmallChange="5" LargeChange="25" Value="{Binding ClipSpeed}" AutomationProperties.Name="Speed"
                      Thumb.DragCompleted="Speed_Done" PreviewMouseLeftButtonUp="Speed_Done" KeyUp="Speed_Done" />
              <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Lasts" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="LastsBox" Text="{Binding ClipLasts, UpdateSourceTrigger=LostFocus}" ToolTip="Type how long it should last, such as 60 or 1:00, to slow it down or speed it up to fit" AutomationProperties.Name="Lasts"
                         KeyDown="Lasts_KeyDown" LostKeyboardFocus="Lasts_LostFocus" />
              </DockPanel>
              <StackPanel Margin="0,6,0,0" Visibility="{Binding ClipHasSpeed, Converter={StaticResource VisibleIf}}">
                <RadioButton GroupName="SoundSpeed" Content="Its sound changes speed with it" IsChecked="{Binding ClipStretchesSound}" />
                <RadioButton GroupName="SoundSpeed" Content="Its sound keeps its own speed" IsChecked="{Binding ClipKeepsSoundSpeed}" />
              </StackPanel>
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClipFadeInText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Fade in from black" />
              </DockPanel>
              <Slider Minimum="0" Maximum="3" SmallChange="0.1" LargeChange="0.5" Value="{Binding ClipFadeIn}" AutomationProperties.Name="Fade in" />
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClipFadeOutText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Fade out to black" />
              </DockPanel>
              <Slider Minimum="0" Maximum="3" SmallChange="0.1" LargeChange="0.5" Value="{Binding ClipFadeOut}" AutomationProperties.Name="Fade out" />
              <DockPanel Margin="0,8,0,0" IsEnabled="{Binding CanCrossfade}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClipCrossfadeText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Crossfade from the clip before" />
              </DockPanel>
              <Slider Minimum="0" Maximum="3" SmallChange="0.1" LargeChange="0.5" Value="{Binding ClipCrossfade}" IsEnabled="{Binding CanCrossfade}" AutomationProperties.Name="Crossfade" />
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClipZoomText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Zoom" />
              </DockPanel>
              <Slider Minimum="100" Maximum="400" SmallChange="5" LargeChange="25" Value="{Binding ClipZoom}" AutomationProperties.Name="Zoom" />
              <TextBlock Text="Drag the picture to choose what's in view." Style="{StaticResource Caption}" Margin="0,2,0,0"
                         Visibility="{Binding ClipIsZoomed, Converter={StaticResource VisibleIf}}" />
            </StackPanel>

            <!-- A sound -->
            <StackPanel Visibility="{Binding HasSoundChosen, Converter={StaticResource VisibleIf}}">
              <DockPanel Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SoundVolumeText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Volume" />
              </DockPanel>
              <Slider Minimum="0" Maximum="400" SmallChange="5" LargeChange="25" Value="{Binding SoundVolume}" AutomationProperties.Name="Sound volume" />
              <ComboBox Margin="0,6,0,0" SelectedIndex="{Binding SoundLevelIndex}" AutomationProperties.Name="Even out the sound">
                <ComboBoxItem Content="As recorded" />
                <ComboBoxItem Content="As loud as it can be" />
                <ComboBoxItem Content="Evened out, as for speech" />
              </ComboBox>
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SoundFadeInText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Fade in" />
              </DockPanel>
              <Slider Minimum="0" Maximum="10" SmallChange="0.1" LargeChange="1" Value="{Binding SoundFadeIn}" AutomationProperties.Name="Sound fade in" />
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SoundFadeOutText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Fade out" />
              </DockPanel>
              <Slider Minimum="0" Maximum="10" SmallChange="0.1" LargeChange="1" Value="{Binding SoundFadeOut}" AutomationProperties.Name="Sound fade out" />
              <TextBlock Text="To hear only this, turn the clips' own sound down. Above 100% is heard in the saved video; the preview stops at 100%." Style="{StaticResource Caption}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Words -->
            <StackPanel Visibility="{Binding HasTextChosen, Converter={StaticResource VisibleIf}}">
              <TextBox x:Name="WordsBox" Margin="0,12,0,0" Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Words" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox SelectedIndex="{Binding TextPlaceIndex}" AutomationProperties.Name="Where">
                  <ComboBoxItem Content="Top" />
                  <ComboBoxItem Content="Middle" />
                  <ComboBoxItem Content="Bottom" />
                </ComboBox>
                <ComboBox Grid.Column="2" SelectedIndex="{Binding TextSizeIndex}" AutomationProperties.Name="Size">
                  <ComboBoxItem Content="Small" />
                  <ComboBoxItem Content="Medium" />
                  <ComboBoxItem Content="Large" />
                </ComboBox>
              </Grid>
              <ComboBox Margin="0,8,0,0" SelectedIndex="{Binding TextColourIndex}" AutomationProperties.Name="Colour">
                <ComboBoxItem Content="White" />
                <ComboBoxItem Content="Yellow" />
                <ComboBoxItem Content="Black" />
              </ComboBox>
              <CheckBox Margin="0,8,0,0" Content="Box behind the words" IsChecked="{Binding TextHasBox}" />
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding TextSecondsText}" Style="{StaticResource Caption}" />
                <TextBlock Text="Shown for" />
              </DockPanel>
              <Slider Minimum="0.5" Maximum="15" SmallChange="0.1" LargeChange="1" Value="{Binding TextSeconds}" AutomationProperties.Name="Shown for" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Playing, and the changes. -->
    <DockPanel Grid.Row="3" Margin="0,10,0,10" LastChildFill="False">
      <Button x:Name="PlayButton" DockPanel.Dock="Left" Click="Play_Click" IsEnabled="{Binding HasClips}" Width="44" ToolTip="Play or pause (Space)" AutomationProperties.Name="Play">
        <TextBlock x:Name="PlayIcon" Text="&#xE768;" Style="{StaticResource Icon}" />
      </Button>
      <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Consolas" FontSize="14" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Margin="0,0,4,0">
          <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" />
        </Button>
        <Button Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" Margin="0,0,12,0">
          <TextBlock Text="&#xE7A6;" Style="{StaticResource Icon}" />
        </Button>
        <Button Click="Split_Click" IsEnabled="{Binding CanSplit}" ToolTip="Cut the clip in two at the playhead (S)" AutomationProperties.Name="Split" Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8C6;" Style="{StaticResource Icon}" />
            <TextBlock Text="Split" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <Button Click="Delete_Click" IsEnabled="{Binding CanDelete}" ToolTip="Take out what's chosen (Delete)" AutomationProperties.Name="Delete">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
            <TextBlock Text="Delete" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <!-- The timeline. -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
      <StackPanel>
        <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
          <Canvas x:Name="Timeline" Height="170" Background="Transparent" ClipToBounds="True" AutomationProperties.Name="Timeline" />
        </ScrollViewer>
        <DockPanel Margin="14,6,14,10">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,14,0">
            <Button Click="Add_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Add videos" Margin="0,0,6,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" />
                <TextBlock Text="Videos" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Click="AddSound_Click" IsEnabled="{Binding CanEdit}" ToolTip="Lay music or another sound over the edit, from the playhead" AutomationProperties.Name="Add sound" Margin="0,0,6,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" />
                <TextBlock Text="Sound" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Click="AddText_Click" IsEnabled="{Binding CanAddText}" ToolTip="Put words over the picture, from the playhead" AutomationProperties.Name="Add words">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D2;" Style="{StaticResource Icon}" />
                <TextBlock Text="Words" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="&#xE71F;" Style="{StaticResource Icon}" FontSize="14" Margin="12,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="Zoom" Minimum="0" Maximum="1" Value="0.45" Width="120" VerticalAlignment="Center" ValueChanged="Zoom_ValueChanged" ToolTip="Zoom the timeline" AutomationProperties.Name="Zoom the timeline" />
          </StackPanel>
          <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Saving. -->
    <StackPanel Grid.Row="5" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal">
        <Button Content="Save video…" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" IsEnabled="{Binding CanSave}" />
        <ProgressBar Width="200" Height="4" Margin="12,0,8,0" VerticalAlignment="Center" Maximum="100" Value="{Binding SavePercent, Mode=OneWay}" Visibility="{Binding IsSaving, Converter={StaticResource VisibleIf}}" />
        <Button Content="Stop" Click="Stop_Click" Visibility="{Binding IsSaving, Converter={StaticResource VisibleIf}}" />
        <Button Content="Use in New post" Click="Use_Click" Margin="8,0,0,0" Visibility="{Binding HasSaved, Converter={StaticResource VisibleIf}}" />
        <Button Content="Show in folder" Click="Show_Click" Margin="8,0,0,0" Visibility="{Binding HasSaved, Converter={StaticResource VisibleIf}}" />
      </StackPanel>
      <TextBlock x:Name="MessageText" Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding HasMessage, Converter={StaticResource VisibleIf}}" />
    </StackPanel>
  </Grid>
</UserControl>
