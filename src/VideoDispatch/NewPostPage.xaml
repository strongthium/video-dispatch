<UserControl x:Class="VideoDispatch.App.NewPostPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,26,36,16">
      <TextBlock Text="New post" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,20"
                 Text="Choose a video, say where it goes, and check exactly what will be sent." />

      <!-- The video -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Choose video" Click="Choose_Click" VerticalAlignment="Top" Margin="16,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
            <StackPanel>
              <TextBlock Text="{Binding FileName}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding MetadataText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
              <TextBlock Text="{Binding ShortsText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox Content="Post to TikTok" IsChecked="{Binding PostToTikTok}" Margin="0,0,24,0" />
            <CheckBox Content="Post to YouTube" IsChecked="{Binding PostToYouTube}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- TikTok -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding PostToTikTok, Converter={StaticResource VisibleIf}}">
        <StackPanel>
          <TextBlock Text="TikTok" Style="{StaticResource Heading}" />
          <TextBlock Text="Preset" Style="{StaticResource Caption}" Margin="0,10,0,4" />
          <ComboBox ItemsSource="{Binding TikTokPresets}" SelectedItem="{Binding TikTokPreset}" DisplayMemberPath="Name" MinWidth="240" HorizontalAlignment="Left" AutomationProperties.Name="TikTok preset" />
          <TextBlock Text="Caption" Style="{StaticResource Caption}" Margin="0,10,0,4" />
          <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="TikTok caption" />
          <TextBlock Text="Before sending" Style="{StaticResource Caption}" Margin="0,10,0,4" />
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding EncodeChoices}" SelectedValue="{Binding TikTokEncodeId, TargetNullValue=''}" SelectedValuePath="Id" DisplayMemberPath="Title" MinWidth="320" AutomationProperties.Name="TikTok before sending" />
            <TextBox Text="{Binding TikTokTargetMegabytes, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="8,0,4,0" AutomationProperties.Name="TikTok size to fit, in megabytes" Visibility="{Binding TikTokFitsSize, Converter={StaticResource VisibleIf}}" />
            <TextBlock Text="MB" VerticalAlignment="Center" Visibility="{Binding TikTokFitsSize, Converter={StaticResource VisibleIf}}" />
          </StackPanel>
          <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,14,0,4" />
          <TextBlock Text="{Binding TikTokPreview}" Style="{StaticResource Muted}" />
        </StackPanel>
      </Border>

      <!-- YouTube -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding PostToYouTube, Converter={StaticResource VisibleIf}}">
        <StackPanel>
          <TextBlock Text="YouTube" Style="{StaticResource Heading}" />
          <TextBlock Text="Preset" Style="{StaticResource Caption}" Margin="0,10,0,4" />
          <ComboBox ItemsSource="{Binding YouTubePresets}" SelectedItem="{Binding YouTubePreset}" DisplayMemberPath="Name" MinWidth="240" HorizontalAlignment="Left" AutomationProperties.Name="YouTube preset" />

          <TextBlock Text="Title" Style="{StaticResource Caption}" Margin="0,10,0,4" />
          <TextBox Text="{Binding YouTubeTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="YouTube title" />
          <TextBlock Text="Description" Style="{StaticResource Caption}" Margin="0,10,0,4" />
          <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="YouTube description" />
          <TextBlock Text="Tags, separated by commas" Style="{StaticResource Caption}" Margin="0,10,0,4" />
          <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="YouTube tags" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Privacy (you must choose)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Privacies}" SelectedValue="{Binding PrivacyId, TargetNullValue=''}" SelectedValuePath="Id" DisplayMemberPath="Title" HorizontalAlignment="Stretch" AutomationProperties.Name="Privacy" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Made for kids (you must choose)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding MadeForKidsChoices}" SelectedValue="{Binding MadeForKidsId, TargetNullValue=''}" SelectedValuePath="Id" DisplayMemberPath="Title" HorizontalAlignment="Stretch" AutomationProperties.Name="Made for kids" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
              <TextBlock Text="Category" Style="{StaticResource Caption}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Categories}" SelectedValue="{Binding CategoryId, TargetNullValue=''}" SelectedValuePath="Id" DisplayMemberPath="Title" HorizontalAlignment="Stretch" AutomationProperties.Name="Category" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
              <TextBlock Text="Playlist" Style="{StaticResource Caption}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Playlists}" SelectedValue="{Binding PlaylistId, TargetNullValue=''}" SelectedValuePath="Id" DisplayMemberPath="Title" HorizontalAlignment="Stretch" AutomationProperties.Name="Playlist" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding ChoicesProblem}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding HasChoicesProblem, Converter={StaticResource VisibleIf}}" />

          <CheckBox Content="Schedule when it goes public" IsChecked="{Binding Scheduled}" Margin="0,14,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding Scheduled, Converter={StaticResource VisibleIf}}">
            <DatePicker SelectedDate="{Binding ScheduleDate}" Width="170" AutomationProperties.Name="Schedule date" />
            <TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="8,0,0,0" AutomationProperties.Name="Schedule time" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding Scheduled, Converter={StaticResource VisibleIf}}"
                     Text="A scheduled video stays private until then, even with this app closed. If it hasn't started uploading by then, it won't start." />

          <TextBlock Text="Before sending" Style="{StaticResource Caption}" Margin="0,14,0,4" />
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding EncodeChoices}" SelectedValue="{Binding YouTubeEncodeId, TargetNullValue=''}" SelectedValuePath="Id" DisplayMemberPath="Title" MinWidth="320" AutomationProperties.Name="YouTube before sending" />
            <TextBox Text="{Binding YouTubeTargetMegabytes, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="8,0,4,0" AutomationProperties.Name="YouTube size to fit, in megabytes" Visibility="{Binding YouTubeFitsSize, Converter={StaticResource VisibleIf}}" />
            <TextBlock Text="MB" VerticalAlignment="Center" Visibility="{Binding YouTubeFitsSize, Converter={StaticResource VisibleIf}}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="YouTube compresses everything again, so re-encoding is mainly for fitting limits. Your original isn't changed." />

          <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,14,0,4" />
          <TextBlock Text="{Binding YouTubePreview}" Style="{StaticResource Muted}" />
        </StackPanel>
      </Border>

      <!-- What's left to do, then queue it -->
      <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False" Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,0,0,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal">
        <Button Content="Add to queue" Click="Queue_Click" Style="{DynamicResource AccentButtonStyle}" IsEnabled="{Binding CanQueue}" />
        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasMessage, Converter={StaticResource VisibleIf}}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
