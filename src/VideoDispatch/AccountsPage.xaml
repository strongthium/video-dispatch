<UserControl x:Class="VideoDispatch.App.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VideoDispatch.App">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,26,36,8">
      <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,20"
                 Text="Video Dispatch has no server. You register your own TikTok and Google apps, and your keys and sign-ins stay in Windows Credential Manager." />
      <!-- Not focusable: a button disabled while it's working would hand it the focus, and draw a frame round every card. -->
      <ItemsControl x:Name="Panels" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:AccountPanel}">
            <local:AccountCard />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
